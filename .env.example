# 請換成至少 32 字元的隨機字串：openssl rand -hex 32
SESSION_SECRET=change-me

# PostgreSQL 密碼請只用 URL 安全字元，或在 DATABASE_URL 中做 percent-encoding。
POSTGRES_PASSWORD=change-me

# 對外 HTTP port
PORT=8080
DB_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# 預設使用 Compose 內的 Mailpit；正式環境請換成 SMTP 服務。
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cronwatch@localhost

{
  "info": {
    "_postman_id": "7c1f0a4e-9c3b-4f2a-8d61-0b5e2a9f4c13",
    "name": "cronwatch",
    "description": "ping 是 cronwatch 唯一的對外 API，不需要認證。check 的建立與管理走網頁介面（/register 註冊後在列表頁操作），把詳情頁的 ping URL 裡那段 uuid 填進 checkId 變數。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:8080"
    },
    {
      "key": "checkId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Ping (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{host}}/ping/{{checkId}}",
          "host": [
            "{{host}}"
          ],
          "path": [
            "ping",
            "{{checkId}}"
          ]
        },
        "description": "cron 跑完後打這個。回 200 空 body。"
      }
    },
    {
      "name": "Ping (GET)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{host}}/ping/{{checkId}}",
          "host": [
            "{{host}}"
          ],
          "path": [
            "ping",
            "{{checkId}}"
          ]
        },
        "description": "GET 也收，給只能發 GET 的環境用。"
      }
    }
  ]
}
